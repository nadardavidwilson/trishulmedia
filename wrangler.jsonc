{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trishulmediav1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "websitedes"
    }
  ],
  "limits": {
    "cpu_ms": 30000
  }
,
  "cache": { "enabled": true }
,
  "images": { "binding": "IMAGES" }
,
  "kv_namespaces": [{ "binding": "VINEXT_KV_CACHE", "id": "b202cf0b38c9435fb7512bf52d3dc30a" }]
}
