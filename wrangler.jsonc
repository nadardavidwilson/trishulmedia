{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trishulmediav1",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.vinext/build/client",
        "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
